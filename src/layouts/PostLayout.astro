---
import type { MarkdownHeading } from 'astro';
import Tag from '../components/Tag.astro';
import { SITE } from '../consts';
import type { BlogPost } from '../utils/posts';
import { formatDate, postHref, readingTime } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  previous?: BlogPost;
  next?: BlogPost;
}

const { post, headings, previous, next } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonicalURL = new URL(postHref(post), Astro.site ?? SITE.url).toString();
const socialImage = '/og.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: canonicalURL,
  image: new URL(socialImage, Astro.site ?? SITE.url).toString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.github,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.author,
  },
  keywords: post.data.tags.join(', '),
  inLanguage: SITE.language,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={socialImage}
  type="article"
  publishedTime={post.data.pubDate}
  schema={schema}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <header class="container article-header">
    <div class="tag-list">
      {post.data.tags.map((tag) => <Tag name={tag} />)}
    </div>
    <h1 class="article-title" data-pagefind-meta="title">{post.data.title}</h1>
    <p class="article-description" data-pagefind-meta="description">{post.data.description}</p>
    <div class="article-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} 分钟阅读</span>
      {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
    </div>
  </header>

  <div class="container article-shell">
    <article class="prose" data-pagefind-body>
      {post.data.archived && (
        <aside class="archived-notice">
          <strong>归档说明：</strong>本文发布于 2018 年，内容按原文保留；其中软件版本、命令或外部服务可能已经变化。
        </aside>
      )}
      <slot />

      <nav class="post-nav" aria-label="文章导航">
        {previous ? (
          <a href={postHref(previous)}>
            <small>← 较早一篇</small>
            {previous.data.title}
          </a>
        ) : <span></span>}
        {next && (
          <a href={postHref(next)}>
            <small>较新一篇 →</small>
            {next.data.title}
          </a>
        )}
      </nav>
    </article>

    <aside class="article-aside" aria-label="文章辅助导航">
      {tocHeadings.length > 0 && (
        <nav class="toc" aria-label="文章目录">
          <p class="toc-title">On this page</p>
          <ol>
            {tocHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="article-actions">
        <button type="button" data-copy-link>复制文章链接</button>
        <a href="/archives/">返回归档</a>
      </div>
    </aside>
  </div>

  <script>
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('[data-pagefind-body]');

    const updateProgress = () => {
      if (!progress || !article) return;
      const start = article.offsetTop;
      const distance = Math.max(1, article.offsetHeight - window.innerHeight);
      const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
      progress.style.width = `${value * 100}%`;
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const button = document.createElement('button');
      button.className = 'copy-code';
      button.type = 'button';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? '';
        await navigator.clipboard.writeText(code);
        button.textContent = '已复制';
        window.setTimeout(() => (button.textContent = '复制'), 1400);
      });
      pre.append(button);
    });

    document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', async (event) => {
      await navigator.clipboard.writeText(location.href);
      const button = event.currentTarget as HTMLButtonElement;
      button.textContent = '链接已复制';
      window.setTimeout(() => (button.textContent = '复制文章链接'), 1400);
    });
  </script>
</BaseLayout>
