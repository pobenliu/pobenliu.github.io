---
import PostCard from '../components/PostCard.astro';
import Tag from '../components/Tag.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { allTags, getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const tags = allTags(posts);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.github,
  },
};
---

<BaseLayout schema={schema}>
  <section class="container hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Poben Liu · Notes since 2018</p>
      <h1 id="hero-title">记录技术、阅读与<em>长期思考</em>。</h1>
      <p class="hero-intro">这里是 pobenliu 的个人笔记。把遇到的问题拆开，把读过的内容留下，也给偶然到访的人一点可复用的线索。</p>
    </div>
    <aside class="hero-note" aria-label="作者寄语">
      <blockquote>写下来，让思考有迹可循。</blockquote>
      <footer>
        <img class="mini-avatar" src="/images/avatar.jpg" alt="" width="64" height="64" />
        <span>pobenliu · Reveries</span>
      </footer>
    </aside>
  </section>

  <section class="container posts-section" aria-labelledby="latest-posts">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2 id="latest-posts">最近文章</h2>
      </div>
      <a class="text-link" href="/archives/">查看全部归档 <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="post-grid">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>

  <section class="container topics-band" aria-labelledby="topics-title">
    <p class="eyebrow">Browse by topic</p>
    <h2 id="topics-title">从一个关键词开始，继续向下读。</h2>
    <div class="tag-list">
      {tags.map(([tag, count]) => <Tag name={tag} count={count} />)}
    </div>
  </section>
</BaseLayout>
