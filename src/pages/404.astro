---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="这个页面不存在，或者已经移动。" noindex canonical={false}>
  <section class="container not-found">
    <div>
      <strong>404</strong>
      <h1>这一页还没有写下来。</h1>
      <p class="page-lede">它可能已经移动，或者地址里有一点小误差。</p>
      <a class="button-link" href="/">返回首页</a>
    </div>
  </section>
</BaseLayout>
