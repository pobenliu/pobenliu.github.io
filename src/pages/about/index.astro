---
import { SITE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  image: `${SITE.url}/images/avatar.jpg`,
  sameAs: [SITE.github, SITE.weibo],
};
---

<BaseLayout title="关于" description="关于 pobenliu 与 Hao's blog。" schema={schema}>
  <header class="container page-hero">
    <p class="eyebrow">About this place</p>
    <h1 class="page-title">关于</h1>
  </header>

  <section class="container about-grid">
    <img class="about-avatar" src="/images/avatar.jpg" alt="pobenliu 的头像" width="372" height="372" />
    <div class="about-copy">
      <h2>一个写文字、整理想法的地方。</h2>
      <p>这里是 pobenliu 的个人博客。文章围绕技术实践、阅读与思考展开：记录解决问题的过程，也把值得长期复用的方法整理下来。</p>
      <p>博客最初于 2018 年使用 GitHub Pages、Hexo 和 NexT 搭建。现在仍然托管在 GitHub Pages，但已经迁移到更轻量、可维护的 Astro 静态架构。</p>
      <div class="social-links">
        <a class="button-link" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a class="button-link" href={SITE.weibo} target="_blank" rel="noopener noreferrer">微博 ↗</a>
        <a class="button-link" href="/subscribe/">订阅 RSS</a>
      </div>
    </div>
  </section>
</BaseLayout>
