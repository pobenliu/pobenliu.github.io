---
import type { BlogPost } from '../utils/posts';
import { formatDate, postHref, readingTime } from '../utils/posts';

interface Props {
  post: BlogPost;
  index: number;
}

const { post, index } = Astro.props;
---

<article class="post-card">
  <div class="post-card-top">
    <span class="post-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  </div>
  <h3><a href={postHref(post)}>{post.data.title}</a></h3>
  <p class="post-description">{post.data.description}</p>
  <footer class="post-card-footer">
    <span>{readingTime(post.body)} 分钟阅读</span>
    <span>{post.data.tags[0] ?? '随笔'} ↗</span>
  </footer>
</article>
